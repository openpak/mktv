# kart.openpak.org
MKTV_ADDR=:20190
# One read API per game, on the container network. A game with no address is not offered.
# Mario Kart 8 (Wii U): the mario-kart-8 title's MK8_API_ADDR
MKTV_API_URL=http://openpak-mario-kart-8:22853
# Mario Kart 8 Deluxe (Switch): switch-nex MK8D_API_ADDR
MKTV_MK8D_API_URL=http://host.containers.internal:22854
# Mario Kart 7 (3DS): the mario-kart-7 title's MK7_API_ADDR
MKTV_MK7_API_URL=http://openpak-mario-kart-7:22855
# Mario Kart Wii: wfc-race (paths /api/mkw/v1/...), its internal key is sent as X-WFC-Internal-Key
MKTV_MKW_API_URL=http://openpak-wfc-race:20208
MKTV_MKW_API_KEY=
MKTV_PUBLIC_URL=https://kart.openpak.org
MKTV_OPENPAK_URL=https://openpak.org
# Sign-in through openpak.org single sign-on (client "openkart"). Unset = no sign-in.
# CORE_URL is openpak.org's website as this container reaches it (server to server); the secret
# is SSO_CLIENT_OPENKART_SECRET from the website's .env; the key signs the session cookies.
MKTV_CORE_URL=http://openpak-website:20010
SSO_CLIENT_OPENKART_SECRET=
MKTV_SESSION_KEY=change-me-to-32-or-more-random-characters
# Optional "<id> <name>" lines naming a game's courses (see docs/gaps.md for which ids are confirmed).
#MKTV_COURSES_FILE=/etc/mktv/mk8-courses.txt
#MKTV_MK8D_COURSES_FILE=/etc/mktv/mk8d-courses.txt
#MKTV_MK7_COURSES_FILE=/etc/mktv/mk7-courses.txt
#MKTV_MKW_COURSES_FILE=/etc/mktv/mkw-courses.txt
#MKTV_CONTACT_EMAIL=contact@openpak.org
