# openkart.openpak.org
MKTV_ADDR=:20190
# The mario-kart-8 title's read API (its MK8_API_ADDR), on the container network.
MKTV_API_URL=http://openpak-mario-kart-8:22853
MKTV_PUBLIC_URL=https://openkart.openpak.org
MKTV_OPENPAK_URL=https://openpak.org
# Sign-in through openpak.org single sign-on (client "openkart"). Unset = no sign-in.
# CORE_URL is openpak.org's website as this container reaches it (server to server); the secret
# is SSO_CLIENT_OPENKART_SECRET from the website's .env; the key signs the session cookies.
MKTV_CORE_URL=http://openpak-website:20010
SSO_CLIENT_OPENKART_SECRET=
MKTV_SESSION_KEY=change-me-to-32-or-more-random-characters
# Optional "<id> <name>" lines naming courses (the game's numbering; see docs/courses.md).
#MKTV_COURSES_FILE=/etc/mktv/courses.txt
#MKTV_CONTACT_EMAIL=contact@openpak.org
